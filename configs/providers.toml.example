# Manga Translate Agent provider configuration example
#
# Copy this file to configs/providers.toml, then fill in API keys or set the
# referenced environment variables. The loader resolves model names in this order:
#
#   1. Stage-level model override: model / fallback_model / local_model
#   2. Provider stage model: vision_model for [stages.vision], text_model otherwise
#   3. Provider generic model: model
#   4. Built-in provider defaults, when available

# -----------------------------------------------------------------------------
# Mode 1: Balanced default routing
# -----------------------------------------------------------------------------
# Use a vision-capable model for OCR/page understanding, a cheaper text model for
# translation, and a proofreading model for QA. This is the recommended starting
# point for most projects.

[stages.vision]
primary = "openai"
fallback = "gemini"
# Optional per-stage override for the primary provider. If set, this wins over
# [providers.openai].vision_model and [providers.openai].model.
# model = "gpt-4.1"

[stages.translation]
primary = "openai"
fallback = "deepseek"
local = "ollama"
# Optional route-specific model overrides. These apply to this stage only.
# model = "gpt-4.1-mini"
# fallback_model = "deepseek-chat"
# local_model = "qwen2.5:14b"

[translation]
# Translation optimization settings
# Options:
#   "serial"           - Default, one bubble at a time (safe, slower)
#   "semantic-parallel"- Parallel semantic translation, serial persona rendering (recommended)
#   "parallel"         - Fully parallel (faster, may have memory consistency issues)
#   "pipelined"        - Pipeline mode
parallel_mode = "semantic-parallel"
# Max concurrent LLM calls per page (up to 50 for high-end machines)
max_workers = 10
# Semantic translation timeout per bubble (seconds)
semantic_timeout = 60
# Max concurrent requests in semantic-parallel mode (default: 3)
max_concurrent_requests = 3
# Enable SQLite-based translation caching (recommended for repeated content)
enable_cache = true
# Cache expiration time in days (0 = no expiration)
cache_ttl_days = 30

[stages.qa]
primary = "deepseek"
fallback = "openai"
local = "ollama"
# model = "deepseek-chat"
# fallback_model = "gpt-4.1-mini"
# local_model = "qwen2.5:14b"

# -----------------------------------------------------------------------------
# Mode 2: Single-provider routing with Mimo
# -----------------------------------------------------------------------------
# Use Xiaomi Mimo for all stages - a powerful Chinese vision model.
#
# [stages.vision]
# primary = "mimo"
#
# [stages.translation]
# primary = "mimo"
#
# [stages.qa]
# primary = "mimo"

# -----------------------------------------------------------------------------
# Mode 3: Cost-optimized hybrid routing
# -----------------------------------------------------------------------------
# Keep expensive multimodal models only where images are needed. Use cheaper text
# models for translation/QA and local models as the final fallback.
#
# [stages.vision]
# primary = "gemini"
# model = "gemini-2.0-flash"
# fallback = "cohere"
# fallback_model = "command-a-plus-128k"
#
# [stages.translation]
# primary = "groq"
# model = "llama-3.3-70b-versatile"
# fallback = "deepseek"
# fallback_model = "deepseek-chat"
# local = "ollama"
# local_model = "qwen2.5:14b"
#
# [stages.qa]
# primary = "groq"
# model = "llama-3.3-70b-versatile"
# fallback = "mistral"
# fallback_model = "mistral-small-latest"
# local = "ollama"
# local_model = "qwen2.5:7b"

# -----------------------------------------------------------------------------
# OCR blank-page guard
# -----------------------------------------------------------------------------
# Detect suspicious runs of blank OCR pages after the runtime artifact export.
# Empty auto_recovery_strategy means prompt interactively. Supported automatic
# values: "hybrid", "continue", "abort", "adjust_threshold", "switch_model".

[ocr_guard]
enabled = true
consecutive_blank_threshold = 3
min_text_length = 3
auto_recovery_strategy = ""

[ocr_guard.hybrid_mode]
enabled = false
# Empty means use stages.vision.primary.
vision_model_override = ""

# =============================================================================
# PROVIDER DEFINITIONS
# =============================================================================
# API key values can be literal strings or environment placeholders like
# "${OPENAI_API_KEY}". Some providers also support *_env keys, depending on the
# provider implementation.

# -----------------------------------------------------------------------------
# Official Providers (with dedicated provider classes)
# -----------------------------------------------------------------------------

[providers.openai]
api_key = "${OPENAI_API_KEY}"
vision_model = "gpt-4.1-mini"
text_model = "gpt-4.1-mini"

[providers.anthropic]
api_key = "${ANTHROPIC_API_KEY}"
vision_model = "claude-3-5-sonnet-latest"
text_model = "claude-3-5-haiku-latest"

[providers.gemini]
api_key = "${GEMINI_API_KEY}"
vision_model = "gemini-2.0-flash"
text_model = "gemini-2.0-flash"

[providers.deepseek]
api_key = "${DEEPSEEK_API_KEY}"
model = "deepseek-chat"

[providers.openrouter]
api_key = "${OPENROUTER_API_KEY}"
base_url = "https://openrouter.ai/api/v1"
vision_model = "openai/gpt-4.1-mini"
text_model = "anthropic/claude-3.5-haiku"

[providers.ollama]
base_url = "http://localhost:11434"
model = "qwen2.5:14b"

[providers.lmstudio]
base_url = "http://localhost:1234/v1"
model = "local-model"

[providers.vllm]
base_url = "http://localhost:8000/v1"
model = "local-model"

[providers.llamacpp]
base_url = "http://localhost:8080/v1"
model = "local-model"

[providers.cohere]
api_key = "${COHERE_API_KEY}"
vision_model = "command-a-plus-128k"
text_model = "command-r-plus-08-2024"

[providers.mistral]
api_key = "${MISTRAL_API_KEY}"
vision_model = "pixtral-large-latest"
text_model = "mistral-small-latest"

[providers.groq]
api_key = "${GROQ_API_KEY}"
model = "llama-3.3-70b-versatile"

# -----------------------------------------------------------------------------
# Dedicated Provider: Xiaomi Mimo
# -----------------------------------------------------------------------------
# Chinese vision model from Xiaomi with strong manga translation capabilities.
# Uses dedicated MimoProvider class with pre-configured settings.

[providers.mimo]
provider_type = "mimo"
api_key = "${MIMO_API_KEY}"
base_url = "https://token-plan-cn.xiaomimimo.com/v1"
vision_model = "mimo-v2.5-pro"
text_model = "mimo-v2.5-pro"

# -----------------------------------------------------------------------------
# Generic OpenAI-Compatible Provider
# -----------------------------------------------------------------------------
# Use for any OpenAI-compatible API endpoint with automatic vision capability detection.

[providers.my_custom_endpoint]
provider_type = "generic"
api_key = "${MY_API_KEY}"
base_url = "https://api.my-custom-provider.com/v1"
model = "my-model-name"
supports_vision = true  # Optional: force vision support (auto-detect if omitted)

# =============================================================================
# PRE-CONFIGURED PROFILES (OpenAI-Compatible Gateways)
# =============================================================================
# These providers are pre-configured in the codebase. Simply set the API key
# and they work out of the box via the generic OpenAI-compatible interface.

